# Never commit dependencies, credentials, or local environment files.
node_modules/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
*secret*
.claude/settings.local.json

# Local scratch and logs
*.log
.DS_Store
Thumbs.db

# Founder phone test: local config, record database and kill-switch file are never committed.
founder-call.config.json
founder-call.stop
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Founder voice test: the private voice settings file is never committed.
founder-voice.config.json
founder-voice-call.config.json

# Backups, wrapped keys and encrypted archives are private and never committed (see docs/PRIVATE_BACKUP_AND_RESTORE.md).
*.dpapi
*.bak
*.bak-*
*.enc
*.backup
founder-call-backups/
preserved-work/
